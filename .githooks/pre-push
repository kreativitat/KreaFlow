#!/bin/sh
set -eu
python3 tools/check_publication.py
scanner=$(git config --get kreaflow.gitleaksBinary || command -v gitleaks || true)
if [ -z "$scanner" ]; then
  echo 'Install Gitleaks before pushing public source.' >&2
  exit 1
fi
"$scanner" git --log-opts='--all --full-history' --redact --ignore-gitleaks-allow --max-archive-depth=2 --no-banner
